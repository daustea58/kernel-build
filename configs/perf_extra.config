# ============================================================
#  perf_extra.config
#  Fragment config tambahan di atas vendor/atoll_defconfig
# ============================================================

# --- Module support ---
CONFIG_MODULES=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_FORCE=n
CONFIG_MODULE_SIG_ALL=n

# --- KernelSU Next ---
CONFIG_KSU=y

# --- SUSFS (nama-nama config ini mengikuti dokumentasi susfs4ksu
#     branch kernel-4.14; kalau ada opsi yang tidak dikenali saat
#     `make olddefconfig`, itu normal -- cek CONFIG_SUSFS di susfs4ksu
#     untuk daftar lengkap opsi yang tersedia di branch tsb) ---
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y

# --- Versi/nama kernel disamarkan jadi "perf" ---
CONFIG_LOCALVERSION="-perf"
CONFIG_LOCALVERSION_AUTO=n
