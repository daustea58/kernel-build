# =========================================================================
# perf_extra.config
# Config fragment ini di-merge ke atas vendor/atoll_defconfig pakai
# scripts/kconfig/merge_config.sh, JANGAN diedit manual ke defconfig utama
# supaya gampang di-maintain terpisah.
# =========================================================================

# --- Modules (sesuai request) ---
CONFIG_MODULES=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set

# --- KernelSU (Next) ---
CONFIG_KSU=y

# --- SUSFS (susfs4ksu, branch kernel-4.14) ---
# NOTE: nama-nama config di bawah ini mengikuti konvensi susfs4ksu terbaru.
# Setelah patch diterapkan, cek `grep -r "config KSU_SUSFS" fs/ include/`
# di source hasil patch untuk memastikan nama persis cocok versi yang kepatch,
# karena maintainer sesekali mengubah/menambah nama flag antar rilis.
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_PROC_CMDLINE=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y

# --- Samarkan versi kernel jadi "perf" ---
# Hasil akhir uname -r kira-kira: 4.14.117-perf
CONFIG_LOCALVERSION="-perf"
# CONFIG_LOCALVERSION_AUTO is not set
  
